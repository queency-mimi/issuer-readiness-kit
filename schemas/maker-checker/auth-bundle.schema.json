{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/stellar-institutional-kit/maker-checker/schemas/auth-bundle.schema.json",
  "title": "AuthBundle v1",
  "description": "Portable hand-off document for collecting Soroban authorisation entries from several signers. Contains no secrets. See SPEC.md section 7.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "planId", "requestId", "networkPassphrase", "unsignedTxXdr", "slots", "collected"],
  "properties": {
    "version": { "const": 1 },
    "planId": { "$ref": "#/$defs/hex32" },
    "requestId": { "$ref": "#/$defs/hex32" },
    "networkPassphrase": { "type": "string", "minLength": 1 },
    "unsignedTxXdr": { "$ref": "#/$defs/b64" },
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slotId", "address", "credentialType", "signerNodes", "entryXdr", "preimageHash", "signatureExpirationLedger", "nodes"],
        "properties": {
          "slotId": { "type": "string", "pattern": "^[0-9a-f]{16}:[0-9]+$" },
          "address": { "type": "string", "pattern": "^[GC][A-Z2-7]{55}$" },
          "credentialType": { "enum": ["address", "addressV2", "addressWithDelegates"] },
          "signerNodes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["address", "path", "accountKind", "signed"],
              "properties": {
                "address": { "type": "string", "pattern": "^[GC][A-Z2-7]{55}$" },
                "path": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)*$" },
                "accountKind": { "enum": ["classic", "contract", "unknown"] },
                "signed": { "type": "boolean" }
              }
            }
          },
          "entryXdr": { "$ref": "#/$defs/b64" },
          "preimageHash": { "$ref": "#/$defs/hex32" },
          "signatureExpirationLedger": { "type": "integer", "minimum": 0 },
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["depth", "contract", "function", "argsText"],
              "properties": {
                "depth": { "type": "integer", "minimum": 0 },
                "contract": { "type": "string" },
                "function": { "type": "string" },
                "argsText": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    "collected": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slotId", "nodePath", "signerId", "signedEntryXdr", "collectedAt"],
        "properties": {
          "slotId": { "type": "string", "pattern": "^[0-9a-f]{16}:[0-9]+$" },
          "nodePath": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)*$" },
          "signerId": { "type": "string", "minLength": 1, "maxLength": 64 },
          "signedEntryXdr": { "$ref": "#/$defs/b64" },
          "collectedAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  },
  "$defs": {
    "hex32": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "b64": { "type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$" }
  }
}
